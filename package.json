{
  "name": "aleax",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --names web,sync npm:dev:web npm:dev:sync",
    "dev:web": "vite",
    "dev:p2p": "vite --mode p2p",
    "preview:p2p": "vite build --mode p2p --outDir ../dist/p2p && vite preview --mode p2p --outDir ../dist/p2p",
    "dev:sync": "node --watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node server/index.ts --client dist/client",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "load-test": "node scripts/loadTest.ts"
  },
  "dependencies": {
    "@hocuspocus/extension-database": "^4.9.0",
    "@hocuspocus/extension-throttle": "^4.9.0",
    "@hocuspocus/provider": "^4.9.0",
    "@hocuspocus/server": "^4.7.0",
    "@mantine/core": "^9.8.2",
    "@mantine/hooks": "^9.8.2",
    "@mantine/modals": "^9.8.2",
    "@mantine/notifications": "^9.8.2",
    "@tabler/icons": "^3.52.0",
    "@tabler/icons-react": "^3.52.0",
    "compressorjs": "^1.4.0",
    "idb-keyval": "^6.3.0",
    "konva": "^10.10.0",
    "mantine-contextmenu": "^9.8.3",
    "motion": "^14.14.0",
    "nanoid": "^6.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-konva": "^19.3.2",
    "react-konva-utils": "^2.1.1",
    "react-router": "^8.5.2",
    "simplex-noise": "^4.0.3",
    "sirv": "^3.0.2",
    "trystero": "0.27.0",
    "use-image": "^1.1.4",
    "y-indexeddb": "9.0.12",
    "y-protocols": "1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "oxlint": "^1.94.0",
    "prettier": "3.10.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
